# ─────────────────────────────────────────────────────────────────────────────
# Exemplo de variáveis de ambiente da robo-api.
# Copie para `.env` e preencha. NÃO commitar o `.env` real (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV="local" => cookie sem Secure/host-only (http), CORS de localhost
# + CORS_EXTRA_ORIGINS, e carrega o arquivo .env. Qualquer outro valor = produção.
NODE_ENV="production"
# ENVIRONMENT controla o Bull Board: qualquer valor != "production" o habilita.
ENVIRONMENT="production"
PORT="8080"

# ── Banco / cache ────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://user:pass@host/db"
# Athena usado pelo módulo lawsuits (busca de processos). ATHENA_DATABASE é o
# nome do database/schema no Glue Catalog que contém as tabelas pje_processos/pje_partes.
# ATHENA_ACCESS_KEY_ID/ATHENA_SECRET_ACCESS_KEY são opcionais — sem eles, usa a
# credential chain padrão da AWS SDK (role da task/instância).
ATHENA_REGION="sa-east-1"
ATHENA_OUTPUT_LOCATION="s3://main-prd-lawsuit-frame/athena-results/"
ATHENA_DATABASE=""
ATHENA_ACCESS_KEY_ID=""
ATHENA_SECRET_ACCESS_KEY=""
# Local dos Parquets das 4 tabelas pje_* (mesmo bucket do Athena, outro prefixo) —
# usado pelo webhook pra gravar direto, sem passar por Mongo.
LAWSUIT_DATA_LOCATION="s3://main-prd-lawsuit-frame/pje-enriquecimento/v1"
# JSON espelho por processo (mesmo bucket, outro prefixo) — usado por outras
# ferramentas/pipeline fora do robo-api (coletor Python). O webhook busca o
# existente e mescla as instâncias em vez de sobrescrever cego.
COMUNICACAO_SPOT_LOCATION="s3://main-prd-lawsuit-frame/comunicacao-spot"
REDIS_HOST=""
REDIS_PORT=""
REDIS_URL="redis://user:pass@host:port"

# ── Integrações ──────────────────────────────────────────────────────────────
API_KEY_MASTER=""
AUTHORIZATION_ESCAVADOR=""
BASE_URL_EMPRESAQUI="https://www.empresaqui.com.br/api"
EMPRESAQUI_API_KEY=""
SCRAPING_API_KEY=""
SCRAPING_BASE_URL=""
PIPEDRIVE_PROSOLUTTI_URL=""
PIPEDRIVE_PROSOLUTTI_TOKEN=""

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_S3_REGION="sa-east-1"
AWS_S3_BUCKET_NAME=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# ── Google Cloud / Vertex ────────────────────────────────────────────────────
GCS_BUCKET=""
GOOGLE_PROJECT_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_CLIENT_ID=""
GOOGLE_PRIVATE_KEY_ID=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_VERTEX_LOCATION="us-central1"
GOOGLE_VERTEX_MODEL="gemini-2.5-pro"

# ── Microsoft / SharePoint ───────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_DIRECTORY_ID=""
MICROSOFT_SECRET_ID=""
MICROSOFT_SECRET_VALUE=""
MICROSOFT_SITE_ID=""
MICROSOFT_DRIVE_ID=""
MICROSOFT_ITEM_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# SSO RS256 UNIDIRECIONAL (juri-api -> painel-robo) — ver src/modules/authentication/jwt
# Esta API consome tokens da juri-api e assina os próprios (sessão local), mas
# não publica mais a sessão para a juri-api (sentido painel-robo -> juri-api
# descontinuado). Chaves PEM em uma única linha, com "\n" literais escapados.
# ─────────────────────────────────────────────────────────────────────────────

# Chave PRIVADA do painel-robo (assina os tokens emitidos com iss=painel-robo).
JWT_PRIVATE_KEY_ROBO_API="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Chave PÚBLICA do painel-robo — valida os tokens que ele mesmo emitiu (iss=painel-robo).
JWT_PUBLIC_KEY_ROBO_API="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Chave PÚBLICA da juri-api — valida tokens vindos dela (iss=api.juri.capital).
JWT_PUBLIC_KEY_JURI_API="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Domínio do cookie auth_token COMPARTILHADO da juri-api (só usado p/ limpá-lo
# no logout). O cookie da sessão própria (robo_auth_token) é host-only e ignora
# esta env. Em produção deixe VAZIO (default .juri.capital). Use só para SSO
# local (".juri.local").
AUTH_COOKIE_DOMAIN=""

# Origens extras de CORS (comma-separated) para dev/local. VAZIO em produção.
CORS_EXTRA_ORIGINS=""
